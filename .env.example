# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# Django
SECRET_KEY=your-secret-key-here

# Which AI music provider to use: mureka or suno
MUSIC_API_PROVIDER=mureka

# Mureka AI Music API  (https://platform.mureka.ai)
MUREKA_API_KEY=your-mureka-api-key-here

# Suno AI Music API  (https://sunoapi.org)
SUNO_API_KEY=your-suno-api-key-here
SUNO_BASE_URL=https://api.sunoapi.org
