# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# Django
SECRET_KEY=your-secret-key-here

# Google OAuth (django-allauth)
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorised redirect URI: http://localhost:8000/accounts/google/login/callback/
# 4. Paste the Client ID and Secret below
# 5. In Django Admin → Sites → set domain to: localhost:8000
# 6. In Django Admin → Social Applications → add Google provider with these values
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Which AI music provider to use: mureka or suno
MUSIC_API_PROVIDER=mureka

# Mureka AI Music API  (https://platform.mureka.ai)
MUREKA_API_KEY=your-mureka-api-key-here

# Suno AI Music API  (https://sunoapi.org)
SUNO_API_KEY=your-suno-api-key-here
SUNO_BASE_URL=https://api.sunoapi.org
